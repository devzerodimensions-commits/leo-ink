{
  "name": "leo-ink",
  "private": true,
  "version": "0.1.0",
  "description": "Leo Ink — cloud ERP for the Indian printing industry (Phase 1 / MVP)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true
  }
}
