# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.

# Local dev: `npm run db:start --workspace server` serves PGlite (real PostgreSQL 17,
# WASM) on 5433; `docker compose up -d db` serves postgres:16 on the same port.
#
# `pgbouncer=true` disables Prisma's *named* prepared statements. PGlite serves every
# client from one PostgreSQL backend, so the API and a seed script running together
# would otherwise collide on statement names (42P05). Drop it against a real server.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public&connection_limit=1&pool_timeout=30&pgbouncer=true"

# Signs session tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-random-secret"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# FR-723 — length of the self-serve free trial, in days.
TRIAL_DAYS=14
